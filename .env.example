# Environment variables. Copy to apps/web/.env.local and fill in. Never commit real values.
# Added as each board task needs them (Razorpay in M4-09, Anthropic in M5-02).

# Supabase. For local work, take both values from `npx supabase status` in packages/db.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The AI guide (M5). Off unless AI_PROVIDER is set. claude: ANTHROPIC_API_KEY (paid per question).
# gemini: GEMINI_API_KEY, free tier, local test runs and the eval only (npm run eval:ai); never real athletes.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# S0-08: Sentry DSNs. Unset = Sentry off. Errors only; personal data is scrubbed before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
