# Environment variables. Copy to apps/web/.env.local and fill in. Never commit real values.
# Added as each board task needs them (Razorpay in M4-09, Anthropic in M5-02).

# Supabase. For local work, take both values from `npx supabase status` in packages/db.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email links use this address, never a request's host. Unset = no emails send (they wait in the queue up to 7 days).
NEXT_PUBLIC_SITE_URL=
# Email sender: Gmail SMTP (SMTP_USER is the Gmail address, SMTP_PASS a Google app password), or Resend
# (RESEND_API_KEY and EMAIL_FROM on a verified domain). Gmail wins when both are set, so delete the SMTP pair to move
# to Resend. EMAIL_FROM is optional with Gmail and must use the same Gmail address.
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=
# EMAIL_FROM=

# The AI guide (M5). Off unless AI_PROVIDER is set. claude: ANTHROPIC_API_KEY (paid per question).
# gemini: GEMINI_API_KEY, free tier, local test runs and the eval only (npm run eval:ai); never real athletes.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# M6-11: Cloudflare Turnstile site key (public). Unset = no captcha widget. Pair it with captcha on in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# S0-08: Sentry DSNs. Unset = Sentry off. Errors only; personal data is scrubbed before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
