{
  "name": "fitsphere",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@fitsphere/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "turbo run typecheck lint test build",
    "format": "prettier --write .",
    "test:db": "npm run test:db -w @fitsphere/db",
    "db:start": "npm run db:start -w @fitsphere/db",
    "db:stop": "npm run db:stop -w @fitsphere/db",
    "db:reset": "npm run db:reset -w @fitsphere/db",
    "db:types": "npm run db:types -w @fitsphere/db",
    "eval:ai": "npm run eval:ai -w @fitsphere/web",
    "test:e2e": "npm run test:e2e -w @fitsphere/web"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "supabase@3.0.0": true
  }
}
